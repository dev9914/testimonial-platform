# Render.com Backend Environment Variables
#
# Render Web Service → Environment
#   Build Command:   npm install && npm run build
#   Start Command:   npm run serve
#   Root Directory:  backend
#   Region:          Oregon (or closest to your MongoDB Atlas cluster)
#   Runtime:         Node 20 LTS
#   Health Check:    GET /api/health (returns 200 when MongoDB connected, 503 otherwise)
#
# -----------------------------------------------------------------------------

# Node.js runtime flag (Render sets this automatically; explicit for clarity)
NODE_ENV=production

# Server port (Render injects $PORT at runtime; only override locally)
PORT=10000

# --- Required ----------------------------------------------------------------
# MongoDB Atlas connection string with +srv. AllowList Render outbound IPs
# or use Atlas → Network Access → "Allow Access from Anywhere" for simplicity.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/testimonials?retryWrites=true&w=majority
# --- CORS origins ------------------------------------------------------------
# Comma-separated list of frontend origins that may call this API.
# Local dev is pre-populated. In production, set this to your Vercel domain:
#   CORS_ORIGINS=https://testimonial-app.vercel.app
# You can also list multiple:
#   CORS_ORIGINS=https://testimonial-app.vercel.app,https://www.example.com
# To allow any origin during staging:  CORS_ORIGINS=*
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Optional integrations --------------------------------------------------
# Cloudinary is wired but unused by the current endpoints; leave placeholders.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Gemini AI for testimonial sentiment/confidence/summary.
# Get a free key: https://aistudio.google.com/apikey
#   - Leave blank or set to DISABLED to skip AI (all submissions default to
#     sentiment=unknown with confidence=null, summary=null).
#   - Production model: gemini-flash-latest
GEMINI_API_KEY=your-google-gemini-api-key
